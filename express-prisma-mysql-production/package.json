{
  "name": "express-prisma-mysql-production",
  "version": "1.0.0",
  "private": true,
  "description": "Production-friendly Express.js REST API with Prisma ORM and MySQL",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "node prisma/seed.js",
    "db:seed:roles": "node prisma/seed.js --roles",
    "db:seed:plans": "node prisma/seed.js --plans",
    "db:seed:users": "node prisma/seed.js --users",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "10.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "nodemon": "3.1.10",
    "prisma": "6.19.3"
  },
  "type": "module"
}
