NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MySQL
DATABASE_URL="mysql://root:password@localhost:3306/production_api"
JWT_SECRET="replace-this-with-a-random-secret-at-least-32-chars"
JWT_EXPIRES_IN_SECONDS=3600
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345

# CORS - comma separated origins. Use * only for public APIs without credentials.
CORS_ORIGINS="http://localhost:3000"

# Rate limiting
RATE_LIMIT_WINDOW_MS=90000000
RATE_LIMIT_MAX=100000

# Logging
LOG_LEVEL=info
